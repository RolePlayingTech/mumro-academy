---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ContactDialog from './ContactDialog.astro';
import { glossaryContent } from '../content/glossary';
import { getLessonBySlug } from '../content/lessons';
import { localePath, type SectionProps } from '../lib/contracts';

interface Props extends SectionProps {}
const { locale } = Astro.props;
const c = glossaryContent[locale];
const routePath = localePath(locale, 'glossary');
const origin = Astro.site ?? new URL('https://academy.mumro.io');

const definedTermSchema = {
  '@type': 'DefinedTermSet',
  name: c.metadata.title,
  description: c.metadata.description,
  inLanguage: locale,
  url: new URL(routePath, origin).href,
  hasDefinedTerm: c.terms.map((item) => ({
    '@type': 'DefinedTerm',
    name: item.term,
    description: item.definition,
    url: `${new URL(routePath, origin).href}#${item.id}`,
  })),
};
---
<BaseLayout
  locale={locale}
  title={c.metadata.title}
  description={c.metadata.description}
  routePath={routePath}
  extraSchema={definedTermSchema}
>
  <SiteHeader locale={locale} routePath={routePath} />
  <main id="main" class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={localePath(locale)}>{locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy'}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{locale === 'pl' ? 'Słownik pojęć' : 'Glossary'}</span>
    </nav>

    <header class="page-hero">
      <p class="eyebrow signal">{c.hero.eyebrow}</p>
      <h1>{c.hero.title}</h1>
      <p class="section-intro">{c.hero.lead}</p>
    </header>

    <div class="glossary-grid">
      {c.terms.map((item) => {
        const lesson = getLessonBySlug(locale, item.relatedLesson);
        return (
          <article class="preview-frame term-card" id={item.id}>
            <div class="term-top">
              <span class="badge signal">{item.category}</span>
            </div>
            <h2>{item.term}</h2>
            <p class="term-def">{item.definition}</p>
            <div class="term-why">
              <span class="eyebrow">{locale === 'pl' ? 'Dlaczego to ważne:' : 'Why it matters:'}</span>
              <p>{item.whyItMatters}</p>
            </div>
            <div class="term-foot">
              <a class="text-link" href={localePath(locale, `lessons/${lesson.slug}`)}>
                {c.hero.lessonLinkLabel}: {lesson.number} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
  <SiteFooter locale={locale} />
  <ContactDialog locale={locale} />
</BaseLayout>

<style>
  .breadcrumbs {
    padding-top: 24px;
    font: 400 11px/1.5 var(--mono);
    color: var(--muted);
    display: flex;
    gap: 8px;
  }
  .page-hero {
    padding-block: 28px 44px;
  }
  h1 {
    font: 400 clamp(42px, 5.2vw, 76px)/1.03 var(--display);
    margin: 14px 0 18px;
  }
  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .term-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .term-card h2 {
    font: 400 30px/1.1 var(--display);
    margin: 4px 0 0;
  }
  .term-def {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }
  .term-why {
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .term-why p {
    margin: 6px 0 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .term-foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 820px) {
    .glossary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
