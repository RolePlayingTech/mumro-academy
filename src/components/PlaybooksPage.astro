---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ContactDialog from './ContactDialog.astro';
import { playbooksContent } from '../content/playbooks';
import { tracksContent } from '../content/tracks';
import { localePath, type SectionProps } from '../lib/contracts';

interface Props extends SectionProps {}
const { locale } = Astro.props;
const c = playbooksContent[locale];
const tracks = tracksContent[locale];
const routePath = localePath(locale, 'playbooks');
const origin = Astro.site ?? new URL('https://academy.mumro.io');

const schema = {
  '@type': 'ItemList',
  name: c.metadata.title,
  description: c.metadata.description,
  numberOfItems: c.items.length,
  itemListElement: c.items.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: item.title,
    url: `${new URL(routePath, origin).href}#${item.id}`,
  })),
};
---
<BaseLayout
  locale={locale}
  title={c.metadata.title}
  description={c.metadata.description}
  routePath={routePath}
  extraSchema={schema}
>
  <SiteHeader locale={locale} routePath={routePath} />
  <main id="main" class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={localePath(locale)}>{locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy'}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{locale === 'pl' ? 'Playbooki i Szablony' : 'Playbooks & Blueprints'}</span>
    </nav>

    <header class="page-hero">
      <p class="eyebrow signal">{c.hero.eyebrow}</p>
      <h1>{c.hero.title}</h1>
      <p class="section-intro">{c.hero.lead}</p>
    </header>

    <div class="playbooks-list">
      {c.items.map((item) => {
        const codeId = `playbook-code-${item.id}`;
        const track = tracks[item.trackId];
        return (
          <article class="preview-frame playbook-card" id={item.id}>
            <div class="playbook-meta">
              <span class="badge signal">{item.number}</span>
              <a class="badge" href={localePath(locale, `tracks/${item.trackId}`)}>
                {track.number}: {track.title}
              </a>
              <span class="badge sage">{item.templateFormat}</span>
            </div>
            <h2>{item.title}</h2>
            <p class="playbook-sub">{item.subtitle}</p>

            <div class="playbook-context-grid">
              <div class="ctx-box">
                <span class="eyebrow">{locale === 'pl' ? 'Kiedy stosować' : 'When to use'}</span>
                <p>{item.whenToUse}</p>
              </div>
              <div class="ctx-box mumro">
                <span class="eyebrow signal">{locale === 'pl' ? 'W systemie MUMRO' : 'Connected in MUMRO'}</span>
                <p>{item.mumroBenefit}</p>
              </div>
            </div>

            <div class="code-block-wrap">
              <div class="code-bar">
                <span class="demo-note">{item.templateFormat}</span>
                <button
                  type="button"
                  class="button secondary copy-btn"
                  data-copy-trigger={codeId}
                  data-copy-label={c.hero.copyButton}
                  data-copied-label={c.hero.copiedButton}
                >
                  {c.hero.copyButton}
                </button>
              </div>
              <pre id={codeId}><code>{item.templateCode}</code></pre>
            </div>

            <div class="playbook-foot">
              <a class="text-link" href={localePath(locale, `lessons/${item.relatedLesson}`)}>
                {c.hero.openLessonLabel} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
  <SiteFooter locale={locale} />
  <ContactDialog locale={locale} />
</BaseLayout>

<style>
  .breadcrumbs {
    padding-top: 24px;
    font: 400 11px/1.5 var(--mono);
    color: var(--muted);
    display: flex;
    gap: 8px;
  }
  .page-hero {
    padding-block: 28px 44px;
  }
  h1 {
    font: 400 clamp(42px, 5.2vw, 76px)/1.03 var(--display);
    margin: 14px 0 18px;
  }
  .playbooks-list {
    display: grid;
    gap: 32px;
  }
  .playbook-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .playbook-meta a.badge {
    text-decoration: none;
  }
  .playbook-card h2 {
    font: 400 clamp(28px, 3.2vw, 42px)/1.08 var(--display);
    margin: 14px 0 10px;
  }
  .playbook-sub {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .playbook-context-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  .ctx-box {
    padding: 16px 18px;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .ctx-box.mumro {
    background: var(--sage);
    border-color: #858c7c66;
  }
  .ctx-box p {
    margin: 8px 0 0;
    font-size: 14px;
  }
  .code-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--wash);
    border: 1px solid var(--ink);
    border-bottom: 0;
    padding: 10px 16px;
  }
  .copy-btn {
    min-height: 36px;
    padding: 6px 14px;
  }
  .code-block-wrap pre {
    margin-top: 0;
  }
  @media (max-width: 760px) {
    .playbook-context-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
