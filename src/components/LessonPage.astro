---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ContactDialog from './ContactDialog.astro';
import LessonLab from './LessonLab.astro';
import InlineText from './InlineText.astro';
import LessonGuidance from './LessonGuidance.astro';
import { tracksContent } from '../content/tracks';
import { getAdjacentLessons, getLessonBySlug } from '../content/lessons';
import { lessonSlugs, localePath, type LessonSlug, type Locale } from '../lib/contracts';

interface Props {
  locale: Locale;
  slug: LessonSlug;
}

const { locale, slug } = Astro.props;
const lesson = getLessonBySlug(locale, slug);
const track = tracksContent[locale][lesson.trackId];
const { previous, next } = getAdjacentLessons(locale, slug);
const routePath = localePath(locale, `lessons/${slug}`);
const origin = Astro.site ?? new URL('https://academy.mumro.io');

const pageTitle = `${lesson.number}: ${lesson.title} — ${locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy'}`;

const articleSchema = [
  {
    '@type': ['TechArticle', 'LearningResource'],
    headline: lesson.title,
    description: lesson.metaDescription,
    inLanguage: locale,
    keywords: lesson.keywords.join(', '),
    educationalLevel: lesson.difficultyLabel,
    timeRequired: `PT${lesson.readingTimeMinutes}M`,
    isPartOf: {
      '@type': 'Course',
      name: track.title,
      url: new URL(localePath(locale, `tracks/${track.id}`), origin).href,
    },
    author: {
      '@type': 'Organization',
      name: 'MUMRO Academy',
      url: origin.href,
    },
    publisher: {
      '@type': 'Organization',
      name: 'MUMRO by RolePlayingTech',
      url: locale === 'pl' ? 'https://mumro.io/pl/' : 'https://mumro.io/',
    },
    mainEntityOfPage: new URL(routePath, origin).href,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy',
        item: new URL(localePath(locale), origin).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: `${track.number}: ${track.title}`,
        item: new URL(localePath(locale, `tracks/${track.id}`), origin).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: `${lesson.number}: ${lesson.title}`,
        item: new URL(routePath, origin).href,
      },
    ],
  },
];
---
<BaseLayout
  locale={locale}
  title={pageTitle}
  description={lesson.metaDescription}
  routePath={routePath}
  ogType="article"
  extraSchema={articleSchema}
>
  <SiteHeader locale={locale} routePath={routePath} />
  <main id="main" class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={localePath(locale)}>{locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy'}</a>
      <span aria-hidden="true">/</span>
      <a href={localePath(locale, `tracks/${track.id}`)}>
        {track.number}: {track.title}
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{lesson.number}</span>
    </nav>

    <article class="lesson-article">
      <header class="lesson-header">
        <div class="lesson-badges">
          <span class="badge signal">{lesson.number}</span>
          <a class="badge" href={localePath(locale, `tracks/${track.id}`)}>
            {track.number} · {track.title}
          </a>
          <span class="badge sage">{lesson.difficultyLabel}</span>
          <span class="demo-note">
            {lesson.readingTimeMinutes} {locale === 'pl' ? 'min czytania' : 'min read'}
          </span>
        </div>
        <h1>{lesson.title}</h1>
        <p class="lesson-lead">{lesson.subtitle}</p>

        <!-- Key Takeaways -->
        <div class="preview-frame takeaways-box">
          <span class="eyebrow signal">
            {locale === 'pl' ? 'KLUCZOWE WNIOSKI Z LEKCJI' : 'KEY ARCHITECTURAL TAKEAWAYS'}
          </span>
          <ul>
            {lesson.keyTakeaways.map((point) => (
              <li><InlineText text={point} /></li>
            ))}
          </ul>
        </div>
      </header>

      <LessonGuidance locale={locale} slug={slug} />

      <div class="lesson-body-grid">
        <!-- Sticky Sidebar TOC -->
        <aside class="lesson-sidebar" aria-label={locale === 'pl' ? 'Spis treści lekcji' : 'Lesson contents'}>
          <div class="toc-card">
            <span class="eyebrow">{locale === 'pl' ? 'W tej lekcji' : 'In this lesson'}</span>
            <ul class="toc-list" role="list">
              <li>
                <a href="#problem-statement">{lesson.problemStatement.heading}</a>
              </li>
              {lesson.sections.map((sec) => (
                <li>
                  <a href={`#${sec.id}`}>{sec.heading}</a>
                </li>
              ))}
              <li>
                <a href="#comparison-matrix">{lesson.comparisonTable.caption}</a>
              </li>
              <li>
                <a href="#case-study">{lesson.caseStudy.brand}</a>
              </li>
              <li>
                <a href="#in-mumro">{lesson.mumroIntegration.eyebrow}</a>
              </li>
              <li>
                <a href="#self-audit">{lesson.checklist.title}</a>
              </li>
            </ul>
            <div class="toc-cta">
              <span class="demo-note">{track.mumroCapability}</span>
              <a class="button" href={lesson.mumroIntegration.anchorHref}>
                {lesson.mumroIntegration.anchorLabel}<span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </aside>

        <!-- Main Lesson Content -->
        <div class="lesson-content">
          <!-- Problem Statement & Pattern Contrast -->
          <section class="content-block" id="problem-statement">
            <span class="eyebrow signal">{locale === 'pl' ? 'DIAGNOZA SYSTEMU' : 'SYSTEM DIAGNOSIS'}</span>
            <h2>{lesson.problemStatement.heading}</h2>
            <p><InlineText text={lesson.problemStatement.body} /></p>
            <div class="pattern-contrast">
              <div class="pattern-box anti">
                <span class="eyebrow">{locale === 'pl' ? 'Antywzorzec (Rozproszony)' : 'Anti-Pattern (Disconnected)'}</span>
                <p><InlineText text={lesson.problemStatement.antiPattern} /></p>
              </div>
              <div class="pattern-box connected">
                <span class="eyebrow signal">{locale === 'pl' ? 'Wzorzec połączony (MUMRO)' : 'Connected Pattern (MUMRO)'}</span>
                <p><InlineText text={lesson.problemStatement.connectedPattern} /></p>
              </div>
            </div>
          </section>

          <!-- Numbered Sections -->
          {lesson.sections.map((sec, idx) => {
            const codeId = `lesson-code-${slug}-${idx}`;
            return (
              <section class="content-block" id={sec.id}>
                {sec.levelBadge && <span class="badge signal level-badge">{sec.levelBadge}</span>}
                <h2><InlineText text={sec.heading} /></h2>
                {sec.paragraphs.map((p) => (
                  <p><InlineText text={p} /></p>
                ))}
                {sec.resources && (
                  <div class="resource-list" data-resource-list>
                    {sec.resources.map((resource) => (
                      <article class="reading-resource" data-reading-resource={resource.category}>
                        <span class="resource-category">{resource.category}</span>
                        <h3>
                          <a href={resource.url} target="_blank" rel="noopener noreferrer">
                            {resource.title}<span aria-hidden="true"> ↗</span>
                          </a>
                        </h3>
                        <p>{resource.description}</p>
                      </article>
                    ))}
                  </div>
                )}
                {sec.callout && (
                  <blockquote class="editorial-callout">
                    <span class="eyebrow signal">{sec.callout.label}</span>
                    <p><InlineText text={sec.callout.text} /></p>
                  </blockquote>
                )}
                {sec.codeBlock && (
                  <div class="code-container">
                    <div class="code-header">
                      <span class="demo-note">{sec.codeBlock.caption}</span>
                      <button
                        type="button"
                        class="copy-btn"
                        data-copy-trigger={codeId}
                        data-copy-label={locale === 'pl' ? 'Kopiuj' : 'Copy'}
                        data-copied-label={locale === 'pl' ? 'Skopiowano ✓' : 'Copied ✓'}
                      >
                        {locale === 'pl' ? 'Kopiuj' : 'Copy'}
                      </button>
                    </div>
                    <pre id={codeId} tabindex="0"><code>{sec.codeBlock.code}</code></pre>
                  </div>
                )}
              </section>
            );
          })}

          <!-- Comparison Table -->
          <section class="content-block" id="comparison-matrix">
            <span class="eyebrow signal">{locale === 'pl' ? 'PORÓWNANIE ARCHITEKTURY' : 'ARCHITECTURE COMPARISON'}</span>
            <h2><InlineText text={lesson.comparisonTable.caption} /></h2>
            <div class="table-wrap" tabindex="0">
              <table>
                <thead>
                  <tr>
                    {lesson.comparisonTable.headers.map((h) => (
                      <th scope="col">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {lesson.comparisonTable.rows.map((row) => (
                    <tr>
                      <td><strong><InlineText text={row[0]} /></strong></td>
                      <td><InlineText text={row[1]} /></td>
                      <td class="highlight-cell"><InlineText text={row[2]} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- Interactive System Lab -->
          <LessonLab locale={locale} trackId={lesson.trackId} slug={slug} />

          <!-- Workspace Case Study -->
          <section class="content-block preview-frame case-study-box" id="case-study">
            <div class="case-head">
              <span class="badge signal">{locale === 'pl' ? 'PRZYKŁAD W WORKSPACE' : 'WORKSPACE CASE STUDY'}</span>
              <span class="demo-note">{lesson.caseStudy.brand}</span>
            </div>
            <h2>{lesson.caseStudy.scenarioTitle}</h2>
            <p><InlineText text={lesson.caseStudy.context} /></p>
            <ol class="case-steps">
              {lesson.caseStudy.executionSteps.map((step) => (
                <li><InlineText text={step} /></li>
              ))}
            </ol>
            <p class="case-result">
              <strong>{locale === 'pl' ? 'Rezultat w procesie:' : 'Workflow outcome:'}</strong> <InlineText text={lesson.caseStudy.resultNote} />
            </p>
          </section>

          <!-- Connected in MUMRO Showcase -->
          <section class="content-block mumro-box" id="in-mumro">
            <span class="eyebrow signal">{locale === 'pl' ? 'PRZYKŁAD WDROŻENIA · MUMRO' : 'IMPLEMENTATION EXAMPLE · MUMRO'}</span>
            <h2>{lesson.mumroIntegration.title}</h2>
            <p><InlineText text={lesson.mumroIntegration.summary} /></p>
            <ul>
              {lesson.mumroIntegration.capabilities.map((cap) => (
                <li><InlineText text={cap} /></li>
              ))}
            </ul>
            <div class="mumro-box-actions">
              <a class="button secondary" href={lesson.mumroIntegration.anchorHref}>
                {lesson.mumroIntegration.anchorLabel}<span aria-hidden="true">↗</span>
              </a>
              <a class="button secondary" href={localePath(locale, 'playbooks')}>
                {locale === 'pl' ? 'Zobacz gotowe playbooki' : 'View copy-ready playbooks'}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </section>

          <!-- Interactive Self-Audit Checklist -->
          <section class="content-block preview-frame checklist-box" id="self-audit" data-checklist-root>
            <div class="checklist-head">
              <div>
                <span class="eyebrow signal">
                  {locale === 'pl' ? 'INTERAKTYWNY AUDYT GOTOWOŚCI' : 'INTERACTIVE READINESS AUDIT'}
                </span>
                <h2>{lesson.checklist.title}</h2>
              </div>
              <span class="badge sage" data-checklist-score>
                0 / {lesson.checklist.items.length}
              </span>
            </div>
            <div class="checklist-items">
              {lesson.checklist.items.map((item, idx) => {
                const inputId = `check-${slug}-${idx}`;
                return (
                  <label class="checklist-row" for={inputId}>
                    <input type="checkbox" id={inputId} />
                    <span><InlineText text={item} /></span>
                  </label>
                );
              })}
            </div>
          </section>

          <!-- Prev / Next Lesson Navigation -->
          <nav class="lesson-pagination" aria-label={locale === 'pl' ? 'Kolejne lekcje' : 'Lesson pagination'}>
            {previous ? (
              <a class="preview-frame page-link prev" href={localePath(locale, `lessons/${previous.slug}`)}>
                <span class="eyebrow">← {locale === 'pl' ? 'Poprzednia w katalogu' : 'Previous in catalog'}</span>
                <strong>{previous.number}: {previous.title}</strong>
              </a>
            ) : (
              <a class="preview-frame page-link prev" href={localePath(locale)}>
                <span class="eyebrow">← {locale === 'pl' ? 'Program Akademii' : 'Academy Curriculum'}</span>
                <strong>{locale === 'pl' ? `Wróć do wszystkich ${lessonSlugs.length} lekcji` : `Back to all ${lessonSlugs.length} lessons`}</strong>
              </a>
            )}
            {next ? (
              <a class="preview-frame page-link next" href={localePath(locale, `lessons/${next.slug}`)}>
                <span class="eyebrow signal">{locale === 'pl' ? 'Następna w katalogu' : 'Next in catalog'} →</span>
                <strong>{next.number}: {next.title}</strong>
              </a>
            ) : (
              <a class="preview-frame page-link next" href={localePath(locale, 'playbooks')}>
                <span class="eyebrow signal">{locale === 'pl' ? 'Kolejny krok' : 'Next step'} →</span>
                <strong>{locale === 'pl' ? 'Przejdź do Playbooków i Szablonów' : 'Explore Playbooks & Blueprints'}</strong>
              </a>
            )}
          </nav>
        </div>
      </div>
    </article>
  </main>
  <SiteFooter locale={locale} />
  <ContactDialog locale={locale} />
</BaseLayout>

<style>
  .breadcrumbs {
    padding-top: 24px;
    font: 400 11px/1.5 var(--mono);
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .lesson-header {
    padding-block: 28px 44px;
    border-bottom: 1px solid var(--line-strong);
  }
  .lesson-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .lesson-badges a.badge {
    text-decoration: none;
  }
  h1 {
    font: 400 clamp(38px, 4.8vw, 68px)/1.03 var(--display);
    letter-spacing: -.025em;
    margin: 18px 0 16px;
    max-width: 24ch;
  }
  .lesson-lead {
    font-size: 18px;
    color: var(--muted);
    max-width: 68ch;
    margin: 0 0 28px;
    line-height: 1.6;
  }
  .takeaways-box ul {
    margin: 12px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
    font-size: 14.5px;
  }

  .lesson-body-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 64px);
    padding-top: 44px;
    align-items: start;
  }
  .lesson-sidebar {
    position: sticky;
    top: 24px;
  }
  .toc-card {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 22px;
  }
  .toc-card .toc-list {
    list-style: none;
    margin: 12px 0 20px;
    padding-left: 0;
    display: grid;
    gap: 9px;
    font-size: 13px;
  }
  .toc-card a {
    text-decoration: none;
  }
  .toc-card a:hover {
    text-decoration: underline;
    color: var(--signal-text);
  }
  .toc-cta {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lesson-content {
    display: grid;
    gap: 44px;
  }
  .level-badge {
    display: inline-block;
    margin-bottom: 6px;
  }
  .content-block h2 {
    font: 400 clamp(28px, 3.2vw, 42px)/1.08 var(--display);
    margin: 8px 0 16px;
  }
  .content-block p {
    font-size: 16px;
    line-height: 1.72;
    color: var(--ink);
    margin: 0 0 16px;
    max-width: 72ch;
  }
  .pattern-contrast {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
  .pattern-box {
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--white);
  }
  .pattern-box.connected {
    background: var(--sage);
    border-color: #858c7c66;
  }
  .pattern-box p {
    margin: 8px 0 0;
    font-size: 14px;
  }
  .editorial-callout {
    margin: 22px 0;
    padding: 18px 22px;
    border-left: 3px solid var(--signal);
    background: var(--white);
  }
  .editorial-callout p {
    margin: 6px 0 0;
    font-size: 15px;
    font-weight: 600;
  }

  .code-container {
    margin-top: 20px;
  }
  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: var(--wash);
    border: 1px solid var(--ink);
    border-bottom: 0;
    padding: 10px 16px;
  }
  .copy-btn {
    font: 400 11px/1 var(--mono);
    padding: 6px 10px;
    background: var(--white);
    border: 1px solid var(--line-strong);
  }
  .code-container pre {
    margin-top: 0;
  }

  /* Comparison Table */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    background: var(--white);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    font: 400 11px/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: .06em;
    background: var(--wash);
  }
  .highlight-cell {
    background: #f5f8f2;
  }

  /* Case Study */
  .case-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .case-steps {
    margin: 14px 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }
  .case-result {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    margin: 0 !important;
  }

  /* MUMRO Box */
  .mumro-box {
    background: var(--ink);
    color: var(--white);
    padding: clamp(24px, 3.5vw, 40px);
  }
  .mumro-box .eyebrow.signal {
    color: #ff8e6e;
  }
  .mumro-box h2 {
    color: var(--white);
  }
  .mumro-box p {
    color: #d3d6c9;
  }
  .mumro-box ul {
    margin: 16px 0 24px;
    padding-left: 20px;
    display: grid;
    gap: 8px;
    color: var(--white);
    font-size: 14.5px;
  }
  .mumro-box-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .mumro-box .button.secondary {
    color: var(--white);
    border-color: #858c7c;
  }

  /* Checklist */
  .checklist-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }
  .checklist-items {
    display: grid;
    gap: 10px;
  }
  .checklist-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    background: var(--paper);
    cursor: pointer;
    font-size: 14.5px;
  }
  .checklist-row input {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    accent-color: var(--signal);
    flex-shrink: 0;
  }

  /* Pagination */
  .lesson-pagination {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    padding-top: 12px;
  }
  .page-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .page-link strong {
    font: 400 24px/1.15 var(--display);
  }
  .page-link.next {
    text-align: right;
  }

  /* Further reading */
  .resource-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 22px 0 4px;
  }
  .reading-resource {
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--line);
    background: var(--white);
  }
  .resource-category {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--signal-text);
    font: 400 10px/1.4 var(--mono);
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .reading-resource h3 {
    margin: 0;
    font-size: 16px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .reading-resource h3 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .reading-resource p {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .lesson-body-grid {
      grid-template-columns: 1fr;
    }
    .lesson-sidebar {
      position: static;
    }
  }
  @media (max-width: 680px) {
    .resource-list,
    .pattern-contrast,
    .lesson-pagination {
      grid-template-columns: 1fr;
    }
    .page-link.next {
      text-align: left;
    }
  }
</style>
