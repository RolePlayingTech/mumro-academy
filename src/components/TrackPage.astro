---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ContactDialog from './ContactDialog.astro';
import { tracksContent } from '../content/tracks';
import { getLessonsByTrack } from '../content/lessons';
import { localePath, trackIds, type Locale, type TrackId } from '../lib/contracts';

interface Props {
  locale: Locale;
  trackId: TrackId;
}

const { locale, trackId } = Astro.props;
const tracks = tracksContent[locale];
const track = tracks[trackId];
const lessons = getLessonsByTrack(locale, trackId);
const routePath = localePath(locale, `tracks/${trackId}`);
const origin = Astro.site ?? new URL('https://academy.mumro.io');

const pageTitle = `${track.number}: ${track.title} — ${locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy'}`;

const courseSchema = [
  {
    '@type': 'Course',
    name: track.title,
    description: track.summary,
    provider: {
      '@type': 'Organization',
      name: 'MUMRO Academy',
      sameAs: 'https://mumro.io/',
    },
    inLanguage: locale,
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
    },
    syllabusSections: lessons.map((l) => ({
      '@type': 'Syllabus',
      name: `${l.number}: ${l.title}`,
      description: l.subtitle,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy',
        item: new URL(localePath(locale), origin).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: `${track.number}: ${track.title}`,
        item: new URL(routePath, origin).href,
      },
    ],
  },
];
---
<BaseLayout
  locale={locale}
  title={pageTitle}
  description={track.summary}
  routePath={routePath}
  extraSchema={courseSchema}
>
  <SiteHeader locale={locale} routePath={routePath} />
  <main id="main" class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={localePath(locale)}>{locale === 'pl' ? 'Akademia MUMRO' : 'MUMRO Academy'}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{track.number}: {track.title}</span>
    </nav>

    <section class="track-hero">
      <div class="track-hero-meta">
        <span class="badge signal">{track.number}</span>
        <span class="badge">{lessons.length} {locale === 'pl' ? 'lekcje w ścieżce' : 'lessons in track'}</span>
        <span class="demo-note">{track.audience}</span>
      </div>
      <h1>{track.title}</h1>
      <p class="track-lead">{track.summary}</p>

      <div class="track-architecture-grid">
        <div class="preview-frame">
          <span class="eyebrow">{locale === 'pl' ? 'Problem rozproszonych narzędzi' : 'Disconnected Stack Problem'}</span>
          <p>{track.coreProblem}</p>
        </div>
        <div class="preview-frame">
          <span class="eyebrow signal">{locale === 'pl' ? 'Docelowy stan systemu' : 'Connected System Outcome'}</span>
          <p>{track.systemOutcome}</p>
        </div>
        <div class="preview-frame">
          <span class="eyebrow">{locale === 'pl' ? 'Czego nauczysz się w praktyce' : 'What You Will Master'}</span>
          <ul>
            {track.outcomes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="eyebrow signal">{locale === 'pl' ? 'PROGRAM ŚCIEŻKI' : 'TRACK SYLLABUS'}</p>
      <h2 class="section-title">
        {locale === 'pl' ? 'Lekcje krok po kroku.' : 'Step-by-step lessons.'}
      </h2>
      <div class="syllabus-list">
        {lessons.map((lesson) => (
          <article class="preview-frame syllabus-card">
            <div class="syllabus-left">
              <div class="syllabus-badges">
                <span class="badge signal">{lesson.number}</span>
                <span class="badge sage">{lesson.difficultyLabel}</span>
                <span class="demo-note">
                  {lesson.readingTimeMinutes} {locale === 'pl' ? 'min czytania' : 'min read'}
                </span>
              </div>
              <h3>
                <a href={localePath(locale, `lessons/${lesson.slug}`)}>{lesson.title}</a>
              </h3>
              <p class="syllabus-sub">{lesson.subtitle}</p>
              <ul class="syllabus-points">
                {lesson.keyTakeaways.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
            <div class="syllabus-right">
              <span class="eyebrow">{locale === 'pl' ? 'Studium przypadku' : 'Case Study'}</span>
              <p class="case-brand">{lesson.caseStudy.brand}</p>
              <p class="case-title">{lesson.caseStudy.scenarioTitle}</p>
              <a class="button" href={localePath(locale, `lessons/${lesson.slug}`)}>
                {locale === 'pl' ? 'Otwórz lekcję' : 'Read lesson'}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <p class="eyebrow">{locale === 'pl' ? 'POZOSTAŁE ŚCIEŻKI AKADEMII' : 'OTHER ACADEMY TRACKS'}</p>
      <div class="other-tracks">
        {trackIds
          .filter((id) => id !== trackId)
          .map((id) => (
            <a class="preview-frame other-track-card" href={localePath(locale, `tracks/${id}`)}>
              <span class="eyebrow signal">{tracks[id].number}</span>
              <strong>{tracks[id].title}</strong>
              <span>{tracks[id].subtitle}</span>
            </a>
          ))}
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} />
  <ContactDialog locale={locale} />
</BaseLayout>

<style>
  .breadcrumbs {
    padding-top: 24px;
    font: 400 11px/1.5 var(--mono);
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .track-hero {
    padding-block: 28px 56px;
  }
  .track-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  h1 {
    font: 400 clamp(42px, 5.2vw, 76px)/1.03 var(--display);
    margin: 16px 0 18px;
  }
  .track-lead {
    font-size: 17px;
    color: var(--muted);
    max-width: 68ch;
    margin: 0 0 32px;
  }
  .track-architecture-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .track-architecture-grid p,
  .track-architecture-grid ul {
    font-size: 14px;
    margin: 12px 0 0;
  }
  .track-architecture-grid ul {
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  .syllabus-list {
    display: grid;
    gap: 24px;
    margin-top: 28px;
  }
  .syllabus-card {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 32px;
    align-items: center;
  }
  .syllabus-badges {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .syllabus-card h3 {
    font: 400 clamp(28px, 3vw, 40px)/1.08 var(--display);
    margin: 12px 0 10px;
  }
  .syllabus-card h3 a {
    text-decoration: none;
  }
  .syllabus-card h3 a:hover {
    text-decoration: underline;
    color: var(--signal-text);
  }
  .syllabus-sub {
    color: var(--muted);
    margin: 0 0 14px;
  }
  .syllabus-points {
    margin: 0;
    padding-left: 18px;
    font-size: 13.5px;
    display: grid;
    gap: 6px;
  }
  .syllabus-right {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .case-brand {
    font-weight: 700;
    font-size: 13px;
    margin: 4px 0 0;
  }
  .case-title {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .other-tracks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }
  .other-track-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .other-track-card strong {
    font: 400 26px/1.12 var(--display);
  }
  .other-track-card span:last-child {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .track-architecture-grid,
    .syllabus-card,
    .other-tracks {
      grid-template-columns: 1fr;
    }
  }
</style>
